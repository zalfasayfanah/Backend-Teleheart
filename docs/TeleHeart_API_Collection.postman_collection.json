        {
          "name": "3. Detail Konsultasi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/consultations/{{consultation_id}}"
          }
        },
        {
          "name": "4. Riwayat Konsultasi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/consultations"
          }
        }
      ]
    },
    {
      "name": "Fase 6 - Pembayaran Mayar",
      "item": [
        {
          "name": "1. Checkout Pembayaran (Dapatkan Link Mayar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"e4582baa-b1f0-4c1c-a527-b9350d5d6c7f\",\n  \"duration_minutes\": 15\n}"
            },
            "url": "{{base_url}}/consultations/{{consultation_id}}/checkout"
          }
        },
        {
          "name": "2. Simulasi Webhook Mayar (Sukses Bayar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.received\",\n  \"data\": {\n    \"productId\": \"{{mayar_invoice_id}}\",\n    \"status\": \"SUCCESS\",\n    \"paymentMethod\": \"QRIS\",\n    \"amount\": 55000,\n    \"extraData\": {\n      \"consultationId\": \"{{consultation_id}}\"\n    }\n  }\n}"
            },
            "url": "{{base_url}}/webhooks/mayar?token={{mayar_secret}}"
          }
        }
      ]
    },
    {
      "name": "Fase 7 - Alur Dokter & Konsultasi",
      "item": [
        {
          "name": "1. Dokter Lihat Antrean Masuk",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/doctors/me/queue?type=incoming"
          }
        },
        {
          "name": "2. Dokter Terima Konsultasi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/consultations/{{consultation_id}}/accept"
          }
        },
        {
          "name": "3. Dokter Lihat Sesi Aktif",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/doctors/me/queue?type=active"
          }
        },
        {
          "name": "4. Dokter Lihat Riwayat Medis Pasien",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/patients/{{patient_id}}/history"
          }
        },
        {
          "name": "5. Dokter Tutup Konsultasi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
