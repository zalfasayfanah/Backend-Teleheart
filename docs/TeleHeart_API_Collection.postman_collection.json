    {
      "name": "11. Modul Admin & Audit Trail",
      "item": [
        {
          "name": "1. Daftar Seluruh Pengguna Sistem",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Melihat seluruh pengguna (dokter, pasien, admin) dengan pagination dan filter role/search."
          }
        },
        {
          "name": "2. Filter Pasien (NIK Ter-masking)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users?role=patient",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "patient"
                }
              ]
            },
            "description": "Memastikan NIK pasien terlindungi dan di-masking (************0001) sesuai standar privasi UU PDP."
          }
