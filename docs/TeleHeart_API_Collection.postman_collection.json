            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_summary\": \"Pasien mengalami angina stabil ringan. Edukasi istirahat cukup dan kurangi kafein.\"\n}"
            },
            "url": "{{base_url}}/consultations/{{consultation_id}}/close"
          }
        }
      ]
    },
