# ==============================================================================
# TELEHEART BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu isi nilainya secara lengkap.
# JANGAN PERNAH commit file .env ke Git!
# ==============================================================================

# Port lokal saat dijalankan tanpa serverless
PORT=8888
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mayar Configuration (Payment Gateway)
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
MAYAR_WEBHOOK_SECRET=

# Firebase Cloud Messaging (FCM Push Notification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Security & Data Privacy (32-byte hex string)
NIK_ENCRYPTION_KEY=
NIK_HASH_PEPPER=
JOBS_SECRET=

# App & Network Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_BASE_URL=http://localhost:3000

# Business Rules Constants
DOCTOR_RESPONSE_TIMEOUT_MINUTES=15
MAX_DOCTOR_REASSIGN=3
PAYMENT_INVOICE_TTL_MINUTES=60

